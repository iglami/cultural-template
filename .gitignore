# GENERADO por scripts/check-theme.mts en cada build, y no lo importa nadie:
# es una copia revisable del tema derivado de content.brand. Se desversiona
# porque cambia con la marca de CADA cliente — versionado, es un conflicto
# asegurado al traer mejoras de la plantilla a un sitio ya entregado.
# Se regenera solo con `npm run build`.
src/app/tema.module.css

